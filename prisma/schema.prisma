generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cycle de vie : nouvelle -> confirmee (colis créé sur Forcelog) ou annulee.
// forcelogStatus stocke tel quel le statut brut renvoyé par Forcelog
// (on ne connaît pas leur vocabulaire exact, donc pas de traduction figée ici).
model Order {
  id               String      @id @default(cuid())
  // Nul pour les commandes créées manuellement dans le CRM (Module 1) —
  // Postgres autorise plusieurs NULL sous une contrainte unique.
  shopifyOrderId   String?     @unique
  source           OrderSource @default(SHOPIFY)
  orderNumber      String
  customerName     String
  address          String
  city             String
  phone            String
  totalPrice       Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(NOUVELLE)

  // Champs modifiables sur l'écran de vérification avant envoi à Forcelog
  // (voir app/orders/[id]/confirm) — conservés pour traçabilité une fois
  // le colis créé.
  quartier         String?
  comment          String?
  fragile          Boolean     @default(false)

  forcelogCode            String? // code colis renvoyé par AddParcel
  forcelogStatus          String? // dernier statut brut connu (GetTracking/GetParcel)
  forcelogError           String? // dernière erreur Forcelog (ex: ville non reconnue)
  forcelogProductNature   String? // "PRODUCT_NATURE" effectivement envoyé à AddParcel
  forcelogTrackingHistory Json? // dernier historique GetTracking connu, mis à jour par le cron
  forcelogSyncedAt        DateTime?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            OrderItem[]

  @@index([status])
  @@index([forcelogCode])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title    String
  quantity Int
  price    Decimal @db.Decimal(10, 2)
}

enum OrderStatus {
  NOUVELLE
  CONFIRMEE
  ANNULEE
}

enum OrderSource {
  SHOPIFY
  MANUEL
}

// Brouillon de fiche produit généré par l'IA (Module 3), en attente de
// relecture/correction avant création réelle sur Shopify. Supprimé une
// fois le produit créé (ou abandonné) — pas d'historique à conserver.
model ProductDraft {
  id               String   @id @default(cuid())
  imagePathnames   Json // string[] (pathnames Vercel Blob, store privé)
  cost             Decimal  @db.Decimal(10, 2)
  title            String
  about            String
  features         Json // string[]
  sizes            Json // string[]
  tags             Json // string[]
  brand            String?
  price            Decimal  @db.Decimal(10, 2)
  compareAtPrice   Decimal  @db.Decimal(10, 2)
  collectionId     String? // gid Shopify, choisi ou confirmé par l'utilisateur
  collectionTitle  String?
  collectionAmbiguous Boolean @default(false)
  createdAt        DateTime @default(now())
}
