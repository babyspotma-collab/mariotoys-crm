generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cycle de vie : nouvelle -> confirmee (colis créé sur Forcelog) ou annulee.
// forcelogStatus stocke tel quel le statut brut renvoyé par Forcelog
// (on ne connaît pas leur vocabulaire exact, donc pas de traduction figée ici).
model Order {
  id               String      @id @default(cuid())
  // Nul pour les commandes créées manuellement dans le CRM (Module 1) —
  // Postgres autorise plusieurs NULL sous une contrainte unique.
  shopifyOrderId   String?     @unique
  source           OrderSource @default(SHOPIFY)
  orderNumber      String
  customerName     String
  address          String
  city             String
  phone            String
  totalPrice       Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(NOUVELLE)

  // Transporteur choisi à la confirmation (voir app/orders/[id]/confirm) —
  // Forcelog et Ozon Express sont deux intégrations totalement
  // indépendantes (vocabulaires de statut différents, pas de champ
  // commun), ce champ dit juste lequel des deux blocs de champs
  // ci-dessous est pertinent pour cette commande.
  carrier          Carrier     @default(FORCELOG)

  // Champs modifiables sur l'écran de vérification avant envoi au
  // transporteur (voir app/orders/[id]/confirm) — conservés pour
  // traçabilité une fois le colis créé.
  quartier         String?
  comment          String?
  fragile          Boolean     @default(false)

  forcelogCode            String? // code colis renvoyé par AddParcel
  forcelogStatus          String? // dernier libellé FR connu (ex: "Attente De Ramassage")
  forcelogStatusCode      String? // dernier STATUS_CODE machine connu (ex: "WAITING_PICKUP") — utilisé pour le filtrage fiable des catégories, forcelogStatus reste pour l'affichage
  forcelogError           String? // dernière erreur Forcelog (ex: ville non reconnue)
  forcelogProductNature   String? // "PRODUCT_NATURE" effectivement envoyé à AddParcel
  forcelogTrackingHistory Json? // dernier historique GetTracking connu, mis à jour par le cron
  forcelogSyncedAt        DateTime? // dernière TENTATIVE de sync (réussie ou non), mis à jour à chaque run du cron
  forcelogStatusChangedAt DateTime? // mis à jour uniquement quand forcelogStatus a réellement changé de valeur
  forcelogSyncFailCount   Int       @default(0) // remis à 0 dès qu'une sync réussit

  // Ozon Express n'expose pas de code machine séparé du statut (pas de
  // STATUS_CODE comme Forcelog) : ozonStatus sert à la fois à l'affichage
  // ET de clé de catégorisation (voir lib/ozon-categories.ts).
  ozonCode            String? // TRACKING-NUMBER renvoyé par add-parcel
  ozonStatus          String? // dernier libellé de statut connu (ex: "Mise en distribution")
  ozonError           String? // dernière erreur Ozon (ex: ville non reconnue)
  ozonTrackingHistory Json? // dernier historique tracking connu, mis à jour par le cron
  ozonSyncedAt        DateTime? // dernière TENTATIVE de sync (réussie ou non)
  ozonStatusChangedAt DateTime? // mis à jour uniquement quand ozonStatus a réellement changé de valeur
  ozonSyncFailCount   Int       @default(0)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            OrderItem[]
  parcels          Parcel[]

  @@index([status])
  @@index([forcelogCode])
  @@index([ozonCode])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title    String
  quantity Int
  price    Decimal @db.Decimal(10, 2)
}

enum OrderStatus {
  NOUVELLE
  CONFIRMEE
  ANNULEE
}

enum OrderSource {
  SHOPIFY
  MANUEL
}

enum Carrier {
  FORCELOG
  OZON
}

// Vue directe et complète de ce qui existe réellement chez chaque
// transporteur (pas seulement ce qui a été créé via app/orders/[id]/confirm)
// — synchronisée depuis leurs dashboards web respectifs (voir
// scripts/sync-forcelog-web.js et scripts/sync-ozon-web.js), qui listent
// TOUS les colis du compte, y compris ceux créés en dehors du CRM.
// orderId reste nul tant qu'aucune commande locale ne correspond (par
// numéro de téléphone) — un Parcel existe indépendamment d'un Order.
model Parcel {
  id               String    @id @default(cuid())
  carrier          Carrier
  code             String // code colis chez le transporteur
  orderId          String?
  order            Order?    @relation(fields: [orderId], references: [id])
  receiver         String
  phone            String
  cityName         String
  price            Decimal   @db.Decimal(10, 2)
  status           String // libellé brut (FR) — sert de clé de catégorisation pour Ozon
  statusCode       String? // STATUS_CODE machine — Forcelog uniquement, null pour Ozon
  carrierCreatedAt DateTime? // date de création/ramassage côté transporteur, si connue
  deliveredAt      DateTime? // posée une seule fois, au run de sync où le statut entre dans la catégorie "delivered" — jamais réécrite ensuite (voir app/api/cron/sync-*-web) ; sert au délai moyen de livraison (Statistiques)
  syncedAt         DateTime  @updatedAt

  @@unique([carrier, code])
  @@index([carrier, status])
  @@index([orderId])
}

// File d'attente produit (voir app/product-jobs) — le CRM ne fait QUE
// stocker la photo et créer le job ; le worker externe (projet
// mariotoys-images-automation, sur le PC de l'utilisateur, jamais sur
// Vercel — Playwright/Chrome n'y sont pas adaptés, même raisonnement que
// pour Forcelog/Ozon) fait TOUT le reste via Gemini web : lecture des
// infos sur la photo (prix, référence...), génération des visuels,
// création du produit Shopify en brouillon. Aucune donnée produit n'est
// jamais déduite du nom de fichier (photos = exports WhatsApp aléatoires).
//
// Cycle : EN_ATTENTE (photo uploadée) -> EN_COURS (worker a récupéré le
// job) -> CREE (produit Shopify créé en brouillon, toutes les infos
// lues) ou CREE_A_COMPLETER (créé quand même, mais prix et/ou référence
// illisibles sur la photo — voir missingFields, tag "À compléter" côté
// Shopify) ; ERREUR à tout moment (échec technique réel), avec errorMessage.
model ProductJob {
  id       String           @id @default(cuid())
  status   ProductJobStatus @default(EN_ATTENTE)

  originalPhotoUrl String // Vercel Blob — photo déposée par l'utilisateur
  originalFilename String // conservé pour affichage/traçabilité UNIQUEMENT (nom aléatoire type export WhatsApp) — jamais utilisé pour en déduire une donnée produit
  cost             Decimal? @db.Decimal(10, 2) // prix d'achat lu par le worker sur la photo elle-même ; null si illisible (voir missingFields)
  sku              String?  @db.VarChar(100) // référence lue sur la photo si visible, sinon null (jamais dans la description, voir REGLES_PRODUIT.md)
  sellPrice        Decimal? @db.Decimal(10, 2) // prix de vente calculé par le worker : coût x 2,1, arrondi au multiple de 50 supérieur, -1 DH
  compareAtPrice   Decimal? @db.Decimal(10, 2) // prix barré affiché : entier se terminant par 9, remise 10-30% vs sellPrice
  missingFields    String[] @default([]) // ex: ["cost","sku"] — infos non lisibles sur la photo, produit créé quand même en CREE_A_COMPLETER
  note             String? // signal non bloquant du worker (ex: Gemini a refusé de générer un visuel, photo originale recadrée utilisée à la place)

  generatedImageUrls Json? // array de Vercel Blob URLs, rempli par le worker une fois les visuels générés

  shopifyProductId  String? // gid://shopify/Product/... une fois créé
  shopifyProductUrl String? // lien admin direct, pour l'affichage

  errorMessage String?

  claimedAt   DateTime? // quand le worker a récupéré le job
  completedAt DateTime? // quand CREE/CREE_A_COMPLETER/ERREUR a été atteint

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum ProductJobStatus {
  EN_ATTENTE
  EN_COURS
  IMAGES_PRETES // plus émis depuis le nouveau pipeline (le worker enchaîne directement jusqu'à CREE/CREE_A_COMPLETER) — gardé pour éviter une migration destructive de l'enum Postgres
  CREE
  CREE_A_COMPLETER
  ERREUR
}

// Factures de règlement/virement — synchronisées depuis le dashboard web
// de chaque transporteur (Forcelog : customer.forcelog.ma/index/CRBT/Json,
// voir scripts/sync-forcelog-web.js ; Ozon Express : voir
// scripts/sync-ozon-web.js), aucun endpoint équivalent n'existant sur les
// API publiques. "ref" reste la clé (@id, non composite, pour éviter une
// migration de clé primaire) : les formats de référence Forcelog
// (CRBT-xxxxx) et Ozon sont assez distincts pour qu'une collision soit
// improbable ; carrier sert au filtrage par transporteur sur /billing.
model CrbtInvoice {
  ref          String    @id
  carrier      Carrier   @default(FORCELOG) // toutes les factures existantes avant l'ajout d'Ozon sont Forcelog
  cDate        DateTime
  payDate      DateTime?
  statut       String // libellé nettoyé : "Payé" / "Enregistré" / "Demande Virement" (Forcelog) ou "Payé" / "Programmé" (Ozon)
  parcelsCount Int
  // Ozon Express n'expose aucun détail de frais sur sa page "Liste
  // Virements" (contrairement au CRBT Forcelog) — champs optionnels,
  // null pour les factures Ozon plutôt qu'un 0 trompeur.
  fees         Int?
  feesAmount   Decimal?  @db.Decimal(10, 2)
  balance      Decimal?  @db.Decimal(10, 2)
  amount       Decimal   @db.Decimal(10, 2)
  syncedAt     DateTime  @updatedAt

  @@index([carrier])
}
