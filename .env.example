# Postgres (Vercel Marketplace / Neon) — copié automatiquement dans les
# variables d'env du projet Vercel une fois l'intégration ajoutée.
DATABASE_URL=

# Auth dashboard (mot de passe unique)
DASHBOARD_PASSWORD=
# Chaîne aléatoire longue, générée une fois (ex: openssl rand -hex 32)
SESSION_SECRET=

# Shopify — boutique Mario Toys, identifiants propres à ce projet (compte
# non partagé avec une autre marque)
SHOPIFY_STORE=cvkf4d-z4.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Forcelog
FORCELOG_API_KEY=

# Cron Vercel (protège /api/cron/sync-tracking)
CRON_SECRET=
